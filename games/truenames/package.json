{
  "name": "truenames",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "vitest run",
    "test:browser": "tsx apps/tools/src/cli.ts vectors-browser",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "build": "vite build apps/game",
    "tools": "tsx apps/tools/src/cli.ts",
    "game": "vite apps/game",
    "dungeon": "tsx apps/dungeon/src/server.ts",
    "racer-bot": "tsx apps/dungeon/src/racer-bot.ts",
    "desktop": "corepack pnpm --filter @truenames/desktop start",
    "desktop:dist": "corepack pnpm --filter @truenames/desktop dist",
    "actant-bench": "tsx apps/dungeon/src/actant-bench.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "poseidon-lite": "^0.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
