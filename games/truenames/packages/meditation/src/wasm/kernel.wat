        (br_if $jd (i32.ge_u (local.get $j) (local.get $t)))
        (call $mm (i32.const 192) (i32.add (local.get $row) (i32.shl (local.get $j) (i32.const 5))) (i32.add (i32.const 512) (i32.shl (local.get $j) (i32.const 5))))
        (call $add (i32.add (i32.const 704) (i32.shl (local.get $i) (i32.const 5))) (i32.add (i32.const 704) (i32.shl (local.get $i) (i32.const 5))) (i32.const 192))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $jl)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $ml)))
    (memory.copy (i32.const 512) (i32.const 704) (i32.shl (local.get $t) (i32.const 5)))
    (local.set $r (i32.add (local.get $r) (i32.const 1)))
    (br $round)))
)
(func $toMont (param $d i32) (param $s i32) (call $mm (local.get $d) (local.get $s) (i32.const 32)))
(func $fromMont (param $d i32) (param $s i32) (call $mm (local.get $d) (local.get $s) (i32.const 64)))
(func $permT (param $t i32)
  (if (i32.load (i32.const 100))
    (then
      (if (i32.eq (local.get $t) (i32.const 4))
        (then (call $permOpt (i32.const 4) (i32.const 56) (i32.const 24576) (i32.const 10240)))
        (else (call $permOpt (i32.const 5) (i32.const 60) (i32.const 40960) (i32.const 22528)))))
    (else
      (if (i32.eq (local.get $t) (i32.const 4))
        (then (call $perm (i32.const 4) (i32.const 56) (i32.const 2048) (i32.const 10240)))
        (else (call $perm (i32.const 5) (i32.const 60) (i32.const 11264) (i32.const 22528)))))))
;; hash(t): IN[0..t-1) canonical -> OUT canonical. t = inputs + 1 (4 or 5).
(func (export "hash") (param $t i32)
  (local $i i32)
  (call $zero (i32.const 512))
  (local.set $i (i32.const 1))
  (block $d (loop $l
    (br_if $d (i32.ge_u (local.get $i) (local.get $t)))
    (call $toMont (i32.add (i32.const 512) (i32.shl (local.get $i) (i32.const 5))) (i32.add (i32.const 992) (i32.shl (local.get $i) (i32.const 5))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $permT (local.get $t))
  (call $fromMont (i32.const 1280) (i32.const 512)))
;; grind(count): IN = [TAG, digest, aura, nonce] canonical; THRESH canonical.
;; Returns the first i < count whose name hash h satisfies h < THRESH, with IN[3] left at that nonce; else -1 (IN[3] advanced by count).
(func (export "grind") (param $count i32) (result i32)
  (local $i i32) (local $k i32) (local $x i64) (local $c i64) (local $lt i32) (local $eq i32) (local $a i64) (local $b i64)
  (call $toMont (i32.const 1408) (i32.const 1024))
  (call $toMont (i32.const 1440) (i32.const 1056))
  (call $toMont (i32.const 1472) (i32.const 1088))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (call $zero (i32.const 512))
    (memory.copy (i32.const 544) (i32.const 1408) (i32.const 96))
    (call $toMont (i32.const 640) (i32.const 1120))
    (call $permT (i32.const 5))
    (call $fromMont (i32.const 1280) (i32.const 512))
    ;; OUT < THRESH ? compare from the top limb down
    (local.set $lt (i32.const 0))
    (local.set $k (i32.const 7))
    (block $cd (loop $cl
      (local.set $a (i64.load32_u (i32.add (i32.const 1280) (i32.shl (local.get $k) (i32.const 2)))))
      (local.set $b (i64.load32_u (i32.add (i32.const 1344) (i32.shl (local.get $k) (i32.const 2)))))
      (if (i64.lt_u (local.get $a) (local.get $b)) (then (local.set $lt (i32.const 1)) (br $cd)))
      (br_if $cd (i64.gt_u (local.get $a) (local.get $b)))
      (br_if $cd (i32.eqz (local.get $k)))
      (local.set $k (i32.sub (local.get $k) (i32.const 1)))
      (br $cl)))
    (if (local.get $lt) (then (return (local.get $i))))
    ;; nonce += 1 (carry through all limbs)
    (local.set $c (i64.const 1))
    (local.set $k (i32.const 0))
    (block $id (loop $il
      (br_if $id (i64.eqz (local.get $c)))
      (br_if $id (i32.ge_u (local.get $k) (i32.const 8)))
      (local.set $x (i64.add (i64.load32_u (i32.add (i32.const 1120) (i32.shl (local.get $k) (i32.const 2)))) (local.get $c)))
      (i64.store32 (i32.add (i32.const 1120) (i32.shl (local.get $k) (i32.const 2))) (local.get $x))
      (local.set $c (i64.shr_u (local.get $x) (i64.const 32)))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $il)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const -1))
)