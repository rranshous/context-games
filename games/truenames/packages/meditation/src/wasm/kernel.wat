      (then
        (local.set $i (i32.const 0))
        (block $sd (loop $sl
          (br_if $sd (i32.ge_u (local.get $i) (local.get $t)))
          (call $pow5 (i32.add (i32.const 512) (i32.shl (local.get $i) (i32.const 5))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $sl))))
      (else (call $pow5 (i32.const 512))))
