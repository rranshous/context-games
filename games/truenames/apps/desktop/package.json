{
  "name": "@truenames/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Truenames as a desktop app: the game and its dungeon in one window, no server required.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron . --no-sandbox",
    "dist": "node build.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "@truenames/dungeon-server": "workspace:*",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "@truenames/altar": "workspace:*",
    "@truenames/channel": "workspace:*"
  },
  "build": {
    "appId": "games.truenames",
    "productName": "Truenames",
    "files": [
      "dist/**",
      "game/**"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "artifactName": "Truenames-${version}-linux-${arch}.${ext}",
      "executableName": "truenames",
      "desktop": {
        "entry": {
          "StartupWMClass": "Truenames"
        }
      },
      "syncDesktopName": true
    },
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.5.1",
    "executableName": "truenames",
    "afterPack": "./after-pack.cjs"
  },
  "desktopName": "truenames.desktop"
}
